# ============================================================================
# IT Asset DPP — server environment template
#
# Copy this file to .env (in the server/ folder) and fill in the values.
# Never commit .env. This file contains NO real secrets and must stay that way.
# ============================================================================

# --- Required: database and login ------------------------------------------
# Your MongoDB connection string. Replace the <placeholders> with your own
# database user, password and cluster host. A free MongoDB Atlas M0 cluster
# is enough (see docs/ATLAS_SETUP.md).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/it_asset_dpp?retryWrites=true&w=majority

# Long random string used to sign login tokens. Minimum 32 characters.
# Generate one on your own machine, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-generated-on-your-machine

PORT=5000
NODE_ENV=development

# --- Blockchain anchoring (optional) ---------------------------------------
#
# What anchoring is: the latest hash-chain block's hash is written to an
# external record so later tampering with the local ledger can be detected.
# Only hashes leave the system. No asset or personal data is sent.
#
# ANCHOR_PROVIDER chooses the mode:
#   none      Anchoring is OFF. The hash chain still works locally.
#   mock      RECOMMENDED FOR DEMOS. Free, offline, no account or wallet.
#             Every result is a SIMULATION stored in this app's own database.
#             It is NOT blockchain proof and sends nothing anywhere.
#   ethereum  Real transactions on the Ethereum Sepolia TEST network.
#             Needs the three ANCHOR_* settings below. Test ETH has no value.
#
# If ethereum is chosen and any required setting is missing or invalid, the
# server refuses to start. It never silently falls back to mock.
ANCHOR_PROVIDER=mock

# ---- Only used when ANCHOR_PROVIDER=ethereum --------------------------------
#
# Alchemy (or any Sepolia RPC provider) is ONLY the internet connection to the
# test network. It does NOT create or hold your wallet, and it cannot give you
# a private key. The signing key below must come from a separate test wallet
# that you create yourself in a wallet app. Use a wallet that holds no real
# funds, and never reuse a wallet that holds real money.
#
# ANCHOR_NETWORK=sepolia            (the only supported network; mainnet is refused)
# ANCHOR_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-api-key>
# ANCHOR_PRIVATE_KEY=0x<64 hex characters from your own test wallet>
# ANCHOR_CHAIN_ID=11155111          (must be 11155111; optional)
# ANCHOR_MIN_CONFIRMATIONS=1        (optional, default 1)

# Render: keep these in the Render dashboard (Environment), never in the repository.
# See docs/BLOCKCHAIN-TRUST.md for the exact variables per mode.
